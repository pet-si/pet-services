selectAllUsers:
SELECT * FROM userEntity
WHERE deleted = 0;

selectUserLogin:
SELECT * FROM userEntity
WHERE email = ? AND password = ? AND deleted = 0;

selectReportById:
SELECT * FROM reportEntity
WHERE idReport = ? AND idUser = ? AND deleted = 0;

selectAllReports:
SELECT * FROM reportEntity
WHERE idUser = ? AND deleted = 0;

selectExpenseById:
SELECT * FROM expenseEntity
WHERE idExpense = ? AND idUser = ? AND deleted = 0;

selectAllExpenses:
SELECT * FROM expenseEntity
WHERE idUser = ? AND deleted = 0;

selectClientById:
SELECT * FROM clientEntity
WHERE idClient = ? AND idUser = ? AND deleted = 0;

selectAllClients:
SELECT * FROM clientEntity
WHERE idUser = ? AND deleted = 0;

selectPurchaseOrderById:
SELECT * FROM purchaseOrderEntity
WHERE idPurchaseOrder = ? AND idUser = ? AND deleted = 0;

selectAllPurchaseOrders:
SELECT * FROM purchaseOrderEntity
WHERE idUser = ? AND deleted = 0;

selectProductWithMaterialsById:
SELECT
  productEntity.idProduct,
  productEntity.idUser,
  productEntity.name,
  productEntity.quantity,
  productEntity.costPrice,
  productEntity.salePrice,
  productEntity.minimumStock,
  productEntity.soldQuantity,
  productEntity.updatedAt,
  productEntity.deleted,
  productMaterialsEntity.idMaterial AS pm_idMaterial,
  productMaterialsEntity.idUser AS pm_idUser,
  productMaterialsEntity.quantity AS pm_quantity,
  productMaterialsEntity.updatedAt AS pm_updatedAt,
  productMaterialsEntity.deleted AS pm_deleted
FROM productEntity
LEFT JOIN productMaterialsEntity
  ON productEntity.idProduct = productMaterialsEntity.idProduct
  AND productMaterialsEntity.idUser = ?
  AND productMaterialsEntity.deleted = 0
WHERE productEntity.idProduct = ?
  AND productEntity.idUser = ?
  AND productEntity.deleted = 0;

selectAllProductsWithMaterials:
SELECT
  productEntity.idProduct,
  productEntity.idUser,
  productEntity.name,
  productEntity.quantity,
  productEntity.costPrice,
  productEntity.salePrice,
  productEntity.minimumStock,
  productEntity.soldQuantity,
  productEntity.updatedAt,
  productEntity.deleted,
  productMaterialsEntity.idMaterial AS pm_idMaterial,
  productMaterialsEntity.idUser AS pm_idUser,
  productMaterialsEntity.quantity AS pm_quantity,
  productMaterialsEntity.updatedAt AS pm_updatedAt,
  productMaterialsEntity.deleted AS pm_deleted
FROM productEntity
LEFT JOIN productMaterialsEntity
  ON productEntity.idProduct = productMaterialsEntity.idProduct
  AND productMaterialsEntity.idUser = ?
  AND productMaterialsEntity.deleted = 0
WHERE productEntity.idUser = ?
  AND productEntity.deleted = 0;

selectMaterialById:
SELECT * FROM materialEntity
WHERE idMaterial = ? AND idUser = ? AND deleted = 0;

selectAllMaterials:
SELECT * FROM materialEntity
WHERE idUser = ? AND deleted = 0;

selectProductMaterialById:
SELECT * FROM productMaterialsEntity
WHERE idProduct = ? AND idMaterial = ? AND idUser = ? AND deleted = 0;

selectAllProductMaterials:
SELECT * FROM productMaterialsEntity
WHERE idUser = ? AND deleted = 0;

selectPurchaseOrderProductById:
SELECT * FROM purchaseOrderProductsEntity
WHERE idPurchaseOrder = ? AND idProduct = ? AND idUser = ? AND deleted = 0;

selectAllPurchaseOrderProducts:
SELECT * FROM purchaseOrderProductsEntity
WHERE idUser = ? AND deleted = 0;

selectSettingByName:
SELECT * FROM settingsEntity
WHERE settingName = ?;

selectAllSettings:
SELECT * FROM settingsEntity;

selectLatestSincronization:
SELECT * FROM sincronizationEntity ORDER BY updateTimeStamp DESC LIMIT 1;
