insertUser:
INSERT OR REPLACE INTO userEntity (idUser, name, email, companyName, password)
VALUES (?, ?, ?, ?, ?);

insertReport:
INSERT OR REPLACE INTO reportEntity (idReport, idUser, filePath, date)
VALUES (?, ?, ?, ?);

insertExpense:
INSERT OR REPLACE INTO expenseEntity (idExpense, idUser, name, amount, date, category)
VALUES (?, ?, ?, ?, ?, ?);

insertClient:
INSERT OR REPLACE INTO clientEntity (idClient, idUser, name, cpf, email, phoneNumber, points)
VALUES (?, ?, ?, ?, ?, ?, ?);

insertPurchaseOrder:
INSERT OR REPLACE INTO purchaseOrderEntity (idPurchaseOrder, idUser, idClient, date)
VALUES (?, ?, ?, ?);

insertProduct:
INSERT OR REPLACE INTO productEntity (idProduct, idUser, name, quantity, costPrice, salePrice, minimumStock, soldQuantity)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertMaterial:
INSERT OR REPLACE INTO materialEntity (idMaterial, idUser, name, quantity, costPrice, minimumStock, metric)
VALUES (?, ?, ?, ?, ?, ?, ?);

insertPurchaseOrderProduct:
INSERT OR REPLACE INTO purchaseOrderProductsEntity (idPurchaseOrder, idProduct, idUser, quantity)
VALUES (?, ?, ?, ?);

insertProductMaterial:
INSERT OR REPLACE INTO productMaterialsEntity (idProduct, idMaterial, idUser, quantity)
VALUES (?, ?, ?, ?);

insertSetting:
INSERT OR REPLACE INTO settingsEntity (settingName, value)
VALUES (?, ?);

insertSincronization:
INSERT INTO sincronizationEntity (updateTimeStamp) VALUES (CURRENT_TIMESTAMP);
